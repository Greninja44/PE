# Copy to backend/.env and edit (scripts/setup_mac.sh does this for you). Never commit .env.
PE_DATABASE_URL=sqlite:///./data/pe.db
PE_EXPERIMENTS_DIR=../experiments
# Admin token used to register inference workers (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
PE_ADMIN_TOKEN=change-me

# --- Inference runtime (worker process only) ---------------------------------------------------------
# auto = CUDA → Apple MPS → CPU. Force with mps | cuda | cpu.
PE_DEVICE=auto
# bf16 VLM / fp16 diffusion on MPS & CUDA. Set false if a model produces NaN/black images.
PE_HALF_PRECISION=true
# Reference images are downscaled to this longest side before Qwen3-VL (memory grows with pixels).
PE_VLM_MAX_IMAGE_SIDE=768
PE_VLM_MAX_NEW_TOKENS=1024
# auto = enable diffusers attention slicing on MPS (lower peak memory).
PE_ATTENTION_SLICING=auto
# Unload models after N idle seconds so the Mac stays responsive (0 = keep loaded).
PE_WORKER_IDLE_UNLOAD_S=300
# true = refuse to load a model when free memory < estimate + margin (default: warn and try).
PE_STRICT_MEMORY_CHECK=false
PE_MEMORY_MARGIN_GB=1.0

# --- Optional remote providers -------------------------------------------------------------------------
PE_HF_TOKEN=
# e.g. http://localhost:8080/v1 for llama.cpp / LM Studio / Ollama. Empty = disabled.
PE_OPENAI_COMPAT_BASE_URL=
PE_OPENAI_COMPAT_API_KEY=
PE_OPENAI_COMPAT_MODEL=qwen3-vl-2b
PE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
